[Unit]
Description=IRUR web application
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=irur
Group=irur
WorkingDirectory=/opt/irur-platform
Environment=NODE_ENV=production
EnvironmentFile=/etc/irur/irur.env
ExecStart=/usr/bin/node /opt/irur-platform/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
